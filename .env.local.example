# Copy this file to `.env.local` and drop in your key, then restart `npm run dev`.
#
# When this is set, the AI Tutor drawer hides its API-key field entirely and
# relays every request through the app's own /api/tutor route — nobody has to
# paste a key during a demo.
#
# If it is NOT set, the drawer falls back to a key the user types in, which is
# saved in their browser under localStorage["openai_api_key"].
OPENAI_API_KEY=sk-proj-your-key-here
